<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsAotCompatible>true</IsAotCompatible>
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2090;IL2091;IL3050;IL3051</WarningsAsErrors>
		<RootNamespace>Clutch.Sdk</RootNamespace>
		<AssemblyName>Clutch.Sdk</AssemblyName>
		<PackageId>Clutch.Sdk</PackageId>
		<Version>0.3.0</Version>
		<AssemblyVersion>0.3.0.0</AssemblyVersion>
		<FileVersion>0.3.0.0</FileVersion>
		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Product>Clutch</Product>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Description>SDK for Clutch, a distributed lock platform. Includes a REST administration and observability client and a WebSocket lock client with automatic heartbeat management.</Description>
		<Title>Clutch SDK for .NET</Title>
		<PackageTags>distributed-lock;locking;clutch;websocket</PackageTags>
		<PackageProjectUrl>https://github.com/jchristn/Clutch</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jchristn/Clutch</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReleaseNotes>v0.3.0 release. See https://github.com/jchristn/Clutch/blob/main/CHANGELOG.md for details.</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<!-- Symbols: portable PDBs shipped in a .snupkg, with Source Link metadata. -->
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\..\assets\logo.png">
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\..\LICENSE.md">
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
