<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <StartupObject>Clutch.Server.Program</StartupObject>
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Watson" Version="7.0.15" />
    <PackageReference Include="SyslogLogging" Version="2.0.11" />
    <PackageReference Include="Radiant" Version="0.1.2" />
    <PackageReference Include="Voltaic" Version="0.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clutch.Core\Clutch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="clutch.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
